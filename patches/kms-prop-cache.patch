+      /**
+       * @brief Resolve a DRM property ID by name from a props() result.
+       *
+       * Property IDs are stable for the lifetime of a DRM object, so they can be
+       * resolved once and reused on the per-frame path instead of re-fetching
+       * property metadata (drmModeGetProperty) every frame.
+       *
+       * @param props DRM properties and their current values.
+       * @param name Property name to look up.
+       * @return Property ID, or empty when the property doesn't exist.
+       */
+      std::optional<std::uint32_t> prop_id_by_name(const std::vector<std::pair<prop_t, std::uint64_t>> &props, std::string_view name) {
+        for (auto &[prop, val] : props) {
+          if (prop->name == name) {
+            return prop->prop_id;
+          }
+        }
+        return std::nullopt;
+      }
