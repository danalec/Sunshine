+      /**
+       * @brief Return raw DRM property IDs and current values in a single ioctl.
+       *
+       * Unlike props(), this avoids a drmModeGetProperty() call per property,
+       * which is only needed to resolve property names. Used on the per-frame
+       * capture path where the property IDs are already cached.
+       *
+       * @param id DRM object ID.
+       * @param type DRM object type.
+       * @return Property IDs and their current values, or empty on failure.
+       */
+      std::vector<std::pair<std::uint32_t, std::uint64_t>> prop_values(std::uint32_t id, std::uint32_t type) {
+        obj_prop_t obj_prop = drmModeObjectGetProperties(fd.el, id, type);
+        if (!obj_prop) {
+          return {};
+        }
+
+        std::vector<std::pair<std::uint32_t, std::uint64_t>> values;
+        values.reserve(obj_prop->count_props);
+
+        for (auto x = 0; x < obj_prop->count_props; ++x) {
+          values.emplace_back(obj_prop->props[x], obj_prop->prop_values[x]);
+        }
+
+        return values;
+      }
